    "code": "left-aligned, blank-padded code or identifier",
    "count": "unsigned integer, zero-filled to width; all '*' when it does not fit",
    "money": "right-aligned edited minor units: thousands commas, point, 2 decimals, trailing sign ('-' negative, blank otherwise); all '*' on overflow; all '?' when the source field is not numeric",
    "date": "left-aligned yyyy-mm-dd, or NEVER (000000), or INVALID (not a calendar date / not numeric)",
    "rate": "9.999 annual rate (thousandths); '?????' when not numeric",
    "taxid": "the 9-character tax id exactly as stored, UNMASKED (text rules for non-printables); blank when blank. Parity: bridge value must equal mask(oracle value) (expected_divergence); diffs mask it",
    "pointer": "one-based physical record pointer FILE#n, left-aligned",
    "volatile": "run-dependent value; ignored by parity (ignore_volatile)"
  },
